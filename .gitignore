# 构建产物
/bin/
*.exe

# 本地配置与密钥（绝不入库）
.env
*.env.local

# 数据与临时文件
/data/
/tmp/
# 容器数据目录（含整个数据库集群，绝不入库）
/docker/data/

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 前端依赖与构建产物（npm ci / npm run build 可完整重建，不入快照）
web/node_modules/
web/dist/
# TypeScript 增量编译缓存：本地产物，随 tsc 重新生成
web/tsconfig.tsbuildinfo
# 手册产物：由 docs/html 在构建时同步（scripts/sync-manual.mjs），不重复入库
web/public/manual/

# 小程序的本地私有配置（开发者工具会把「不校验合法域名」等设置写这里）
# 入库会让"关掉域名校验"变成团队默认，掩盖"合法域名没登记"这类真机故障。
/miniprogram/project.private.config.json
