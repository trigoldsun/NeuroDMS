<Slide style={{ width: 1280, height: 720, background: '#F5F7F2', padding: '60px', fontFamily: '"Source Han Sans SC", "Microsoft YaHei", Arial, sans-serif', position: 'relative' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'flex-start', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0A120E' }}>谁最需要它：按外发频次与密级分四类</Text>
        <Text style={{ fontSize: 14, color: '#66756D', marginTop: 10 }}>适用场景</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: '#DDE4DC', marginTop: 14 }} />

    <Box style={{ flexDirection: 'row', marginTop: 20, alignItems: 'center', gap: 10 }}>
        <Text style={{ fontSize: 14, color: '#A9B5AE' }}>密级要求</Text>
        <Text style={{ fontSize: 14, color: '#A9B5AE' }}>低 → 高</Text>
    </Box>

    <Box style={{ flexDirection: 'column', gap: 10, marginTop: 8 }}>
        <Box style={{ flexDirection: 'row', gap: 10 }}>
            {[
                { t: '低频 · 高密', who: '医药研发 / 并购尽调', pain: '极少数文件极高敏感，一次外流就无法挽回。', how: '绝密与核心禁止外发；审批 + 只读 + 一次性链接' },
                { t: '高频 · 高密', who: '设计院 / 制造业', pain: '一份图纸转手多次，谁看过、发给了谁说不清。', how: '外链 + 水印 + 来源网段 + 7 天有效期' },
            ].map((q, i) => (
                <Box key={i} style={{ flex: 1, background: i === 1 ? '#0F5C40' : '#EEF1EA', borderRadius: 10, padding: '18px 20px', flexDirection: 'column', gap: 8 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 14, color: i === 1 ? '#C6EE4B' : '#A9B5AE', letterSpacing: 1 }}>{q.t}</Text>
                        <Box style={{ flex: 1, height: 1, background: i === 1 ? '#1F3A2C' : '#DDE4DC' }} />
                    </Box>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: i === 1 ? '#FFFFFF' : '#0A120E' }}>{q.who}</Text>
                    <Text style={{ fontSize: 17, color: i === 1 ? '#DDE4DC' : '#3F5148', lineHeight: 1.5 }}>{q.pain}</Text>
                    <Text style={{ fontSize: 16, color: i === 1 ? '#A9B5AE' : '#66756D', lineHeight: 1.5 }}>{q.how}</Text>
                </Box>
            ))}
        </Box>
        <Box style={{ flexDirection: 'row', gap: 10 }}>
            {[
                { t: '低频 · 低密', who: '内部归档 / 合规留底', pain: '要的是找得到、不丢版本，权限别比业务复杂。', how: '版本 + 搜索 + 目录继承，先跑起来再谈策略' },
                { t: '高频 · 低密', who: '律所 / 咨询 / 代账', pain: '每天给客户发材料，靠邮件和网盘，出事没记录。', how: '交付链接 + 有效期 + 下载开关 + 访问留痕' },
            ].map((q, i) => (
                <Box key={i} style={{ flex: 1, background: '#EEF1EA', borderRadius: 10, padding: '18px 20px', flexDirection: 'column', gap: 8 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 14, color: '#A9B5AE', letterSpacing: 1 }}>{q.t}</Text>
                        <Box style={{ flex: 1, height: 1, background: '#DDE4DC' }} />
                    </Box>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0A120E' }}>{q.who}</Text>
                    <Text style={{ fontSize: 17, color: '#3F5148', lineHeight: 1.5 }}>{q.pain}</Text>
                    <Text style={{ fontSize: 16, color: '#66756D', lineHeight: 1.5 }}>{q.how}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ marginTop: 14, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Text style={{ fontSize: 14, color: '#A9B5AE' }}>外发频次</Text>
        <Text style={{ fontSize: 14, color: '#A9B5AE' }}>低 → 高（从左到右）</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, right: 60, top: 676, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#A9B5AE' }}>NeuroDMS · 产品概览</Text>
        <Text style={{ fontSize: 14, color: '#A9B5AE' }}>10</Text>
    </Box>
</Slide>
