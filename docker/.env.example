# DocVault 容器配置模板
# 复制为 .env 后填写；.env 含密钥，已被 .gitignore 排除，不得提交

# ---- 运行形态 ----
# development | standalone | saas
DOCVAULT_MODE=standalone

# ---- 数据库 ----
POSTGRES_DB=docvault
POSTGRES_USER=docvault
# 生成方式：openssl rand -hex 16
POSTGRES_PASSWORD=

# ---- 会话令牌签名密钥 ----
# 至少 32 字节随机串；standalone/saas 形态下弱值会拒绝启动
# 生成方式：openssl rand -hex 24
DOCVAULT_JWT_SECRET=

# ---- 可信反向代理网段（逗号分隔）----
# 留空 = 不信任任何 X-Forwarded-For，一律使用直连地址（推荐默认）
# 仅当服务确实位于你自己的反向代理之后才填写，例如 10.0.0.0/8
DOCVAULT_TRUST_PROXY_CIDRS=

# ---- 目录（LDAP / AD）----
# 留空表示不使用域账号；填了会在启动时连接一次做自检
DOCVAULT_LDAP_URL=
DOCVAULT_LDAP_BASE_DN=
DOCVAULT_LDAP_BIND_DN=
DOCVAULT_LDAP_BIND_PASSWORD=
DOCVAULT_LDAP_STARTTLS=0
DOCVAULT_LDAP_INSECURE=0
DOCVAULT_LDAP_AD_MODE=0
# 允许明文绑定：仅实验网。域控未装 LDAP 证书时（LDAPS/StartTLS 都不可用）才需要
DOCVAULT_LDAP_ALLOW_PLAINTEXT=0
# DOCVAULT_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName=%s))

# ---- 通知（SMTP 与 Graph 二选一或都填，都填时 SMTP 为主、Graph 为备）----
DOCVAULT_SMTP_HOST=
DOCVAULT_SMTP_PORT=587
DOCVAULT_SMTP_USER=
DOCVAULT_SMTP_PASS=
DOCVAULT_SMTP_FROM=
DOCVAULT_SMTP_TLS=starttls
DOCVAULT_SMTP_INSECURE=0

DOCVAULT_GRAPH_TENANT_ID=
DOCVAULT_GRAPH_CLIENT_ID=
DOCVAULT_GRAPH_CLIENT_SECRET=
DOCVAULT_GRAPH_SENDER=

# ---- 在线预览 / 编辑 ----
DOCVAULT_PREVIEW_ENABLED=1
DOCVAULT_PREVIEW_DIR=/data/preview
DOCVAULT_PUBLIC_URL=http://127.0.0.1:18090
DOCVAULT_ONLYOFFICE_URL=
DOCVAULT_ONLYOFFICE_JWT_SECRET=
DOCVAULT_ONLYOFFICE_ALLOWED_HOSTS=

# ---- 音视频 ----
DOCVAULT_MEDIA_ENABLED=1
DOCVAULT_MEDIA_DIR=/data/media
# 0 表示按 CPU 核数自动取值（一半，最少 1）
DOCVAULT_MEDIA_CONCURRENCY=0

# ---- 审计 ----
# 日结锚点签名密钥；留空会退回用 JWT 密钥（会在日志里告警）
DOCVAULT_ANCHOR_SECRET=
# 同步专用的用户过滤条件（无占位符）。AD 必须带 objectCategory=person，否则会把计算机账号当人
# DOCVAULT_LDAP_SYNC_FILTER=(&(objectClass=user)(objectCategory=person))
# 不参与同步的账号（逗号分隔）。默认已排除 krbtgt/DefaultAccount/WDAGUtilityAccount
# DOCVAULT_LDAP_EXCLUDE_ACCOUNTS=krbtgt,svc_backup
# ---- LDAPS 客户端信任（推荐做法：不跳过校验）----
# 从 AD 导出的企业 CA（PEM）。导出命令见 README「给域控配 LDAPS」
DOCVAULT_LDAP_CA_FILE=/certs/neurongene-root-ca.pem
# 域控证书通常只有 DNS SAN，按 IP 连时必须指定校验用的名字
DOCVAULT_LDAP_TLS_NAME=NFSDC01.neurongene.cn
